# Environment variables for ERC-4337 Smart Wallet
# Copy this file to .env and fill in your actual values

# Deployer private key (0x-prefixed)
PRIVATE_KEY=0xyour_private_key_here

# RPC URLs
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your-api-key

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key

# Off-chain paymaster sponsorship signer (optional, defaults to deployer)
PAYMASTER_SIGNER=

# Set to true to create a demo wallet during deployment
CREATE_DEMO_WALLET=false
