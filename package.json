{
  "name": "erc4337-smart-wallet",
  "version": "2.0.0",
  "description": "ERC-4337 v0.7 Smart Contract Wallet with social recovery, session keys, and gasless transactions",
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "test:coverage": "forge coverage --ir-minimum",
    "fmt": "forge fmt src/ test/ script/",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://localhost:8545 --broadcast",
    "deploy:sepolia": "forge script script/Deploy.s.sol --rpc-url $SEPOLIA_RPC_URL --broadcast --verify"
  },
  "keywords": [
    "ethereum",
    "erc4337",
    "account-abstraction",
    "smart-contract",
    "wallet",
    "social-recovery",
    "session-keys",
    "gasless"
  ],
